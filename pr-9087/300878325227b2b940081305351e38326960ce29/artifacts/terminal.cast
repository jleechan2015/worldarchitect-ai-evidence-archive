[3.113782, "o", "=== 3. CODE DIFFS ===\r\n"]
[3.561891, "o", "diff --git a/mvp_site/frontend_v1/app.js b/mvp_site/frontend_v1/app.js\r\nindex 4242caf6fb8..eaf5f0e97cf 100644\r\n--- a/mvp_site/frontend_v1/app.js\r\n+++ b/mvp_site/frontend_v1/app.js\r\n@@ -22,6 +22,44 @@ var safeDiag = (name, level, fields) => {\r\n   } catch (e) {}\r\n };\r\n \r\n+// Snapshot the settings asset while this app.js element is executing.\r\n+// Settings is loaded later, so a subsequent DOM scan could select a stale or\r\n+// duplicate app.js element instead of the script that booted this app.\r\n+const getSettingsAssetUrl = (currentScript) => {\r\n+  const fallback = \"/frontend_v1/js/settings.js\";\r\n+  if (!currentScript) return fallback;\r\n+  try {\r\n+    const baseUrl = new URL(document.baseURI || window.location.href);\r\n+    const appSource = currentScript.src || currentScript.getAttribute(\"src\");\r\n+    const appUrl = new URL(appSource, baseUrl);\r\n+    if (appUrl.origin !== baseUrl.origin) return fallback;\r\n+    if (!/^\\/frontend_v1\\/app(?:\\.[a-f0-9]{8})?\\.js$/.test(appUrl.pathname)) {\r\n+      return fallback;\r\n+  "]
[3.561897, "o", "  }\r\n+    const source =\r\n+      currentScript.dataset?.settingsSrc ||\r\n+      currentScript.getAttribute(\"data-settings-src\");\r\n+    if (!source) return fallback;\r\n+    const url = new URL(source, baseUrl);\r\n+    if (url.origin !== baseUrl.origin) return fallback;\r\n"]
[3.561898, "o", "+    if (!/^\\/frontend_v1\\/js\\/settings(?:\\.[a-f0-9]{8})?\\.js$/.test(url.pathname)) {\r\n+      return fallback;\r\n"]
[3.561899, "o", "+    }\r\n+    return url.href;\r\n"]
[3.561901, "o", "+  } catch {\r\n"]
[3.561902, "o", "+    return fallback;\r\n"]
[3.561903, "o", "+  }\r\n+};\r\n"]
[3.561904, "o", "+\r\n"]
[3.561905, "o", "+const frontendSettingsUrl = getSettingsAssetUrl(document.currentScript);\r\n"]
[3.561906, "o", "+\r\n"]
[3.561907, "o", "+const settingsScriptUrl = () => {\r\n"]
[3.561908, "o", "+  return new URL(\r\n"]
[3.561909, "o", "+    frontendSettingsUrl,\r\n"]
[3.561909, "o", "+    document.baseURI || window.location.href,\r\n"]
[3.56191, "o", "+  ).href;\r\n+};\r\n"]
[3.561911, "o", "+\r\n"]
[3.561912, "o", " // Top-of-file boot event. Fires before DOMContentLoaded, so we capture\r\n"]
[3.561913, "o", " // script-load order even when the listener below is the one that runs first.\r\n"]
[3.561913, "o", " safeDiag(\"app.boot_top\", \"info\", {\r\n"]
[3.561923, "o", "@@ -2047,7 +2085,7 @@ document.addEventListener(\"DOMContentLoaded\", () => {\r\n     // Load settings.js if not already loaded\r\n     if (!window.settingsScriptLoaded) {\r\n       const script = document.createElement(\"script\");\r\n-      script.src = \"/frontend_v1/js/settings.js\";\r\n+      script.src = settingsScriptUrl();\r\n       script.onload = () => {\r\n         window.settingsScriptLoaded = true;\r\n"]
[3.561924, "o", "         console.log(\"Settings JavaScript loaded\");\r\n"]
[3.564947, "o", "diff --git a/mvp_site/frontend_v1/index.html b/mvp_site/frontend_v1/index.html\r\nindex 3c2b5054110..c740fd7e992 100644\r\n--- a/mvp_site/frontend_v1/index.html\r\n+++ b/mvp_site/frontend_v1/index.html\r\n@@ -626,7 +626,7 @@\r\n   <script src=\"/frontend_v1/js/inline-editor.js\" defer></script>\r\n   <script src=\"/frontend_v1/js/ember-bg.js\" defer></script>\r\n   <script src=\"/frontend_v1/quick_start_shared.js\" defer></script>\r\n-  <script src=\"/frontend_v1/app.js\" defer></script>\r\n+  <script src=\"/frontend_v1/app.js\" data-settings-src=\"/frontend_v1/js/settings.js\" defer></script>\r\n \r\n   <!-- Share Story modal — placed INSIDE <body>, immediately before </body>.\r\n        Regression guard for PR #5823: a share modal markup was previously\r\n"]
[3.569398, "o", "diff --git a/mvp_site/main.py b/mvp_site/main.py\r\nindex 8a01e11575a..553767de03e 100755\r\n--- a/mvp_site/main.py\r\n+++ b/mvp_site/main.py\r\n@@ -6268,6 +6268,65 @@ def create_app() -> Flask:\r\n         return Response(_PRIVACY_HTML_BODY, mimetype=\"text/html\")\r\n \r\n     # --- Frontend Serving ---\r\n+    _CACHE_BUST_TOKEN_RE = re.compile(r\"[^A-Za-z0-9._-]+\")  # noqa: N806\r\n+    _FRONTEND_ASSET_ATTR_RE = re.compile(  # noqa: N806\r\n"]
[3.569402, "o", "+        r'((?<![A-Za-z0-9_-])(?:href|src|data-settings-src)=\")(/frontend_v1/[^\"]+)(\")',\r\n+        re.IGNORECASE,\r\n+    )\r\n+\r\n+    _PROCESS_DEPLOYMENT_TOKEN = secrets.token_hex(8)  # noqa: N806\r\n+\r\n+    def _deployment_fallback_token() -> str:\r\n+        for env_var in (\"K_REVISION\", \"COMMIT_SHA\", \"CONTAINER_TAG\"):\r\n+            val = os.environ.get(env_var)\r\n+            if val and str(val).strip():\r\n"]
[3.569403, "o", "+                return str(val).strip()\r\n+        app_version = getattr(constants, \"APP_VERSION\", None)\r\n"]
[3.569404, "o", "+        if (\r\n+            app_version\r\n"]
[3.569405, "o", "+            and str(app_version).strip()\r\n+            and str(app_version).strip().lower() != \"dev\"\r\n"]
[3.569406, "o", "+        ):\r\n"]
[3.569407, "o", "+            return str(app_version).strip()\r\n"]
[3.569408, "o", "+        return _PROCESS_DEPLOYMENT_TOKEN\r\n+\r\n"]
[3.56941, "o", "+    def _html_cache_bust_token() -> str | None:\r\n"]
[3.56941, "o", "+        \"\"\"Page-level cache bust: ``?cb=<token>`` or ``?nocache=1``.\r\n"]
[3.569411, "o", "+\r\n"]
[3.569412, "o", "+        Asset ``?v=`` on ``/frontend_v1/<file>`` already exists and means\r\n"]
[3.569413, "o", "+        *immutable* 1-year cache for that URL, so it is the wrong operator\r\n+        control. These query params rewrite HTML asset URLs to a new ``?v=``\r\n"]
[3.569414, "o", "+        and set ``Cache-Control: no-store`` on the HTML itself.\r\n+        \"\"\"\r\n"]
[3.569415, "o", "+        cb = request.args.get(\"cb\")\r\n"]
[3.569416, "o", "+        has_cb = cb is not None and bool(str(cb).strip())\r\n"]
[3.569417, "o", "+\r\n"]
[3.569418, "o", "+        val = request.args.get(\"nocache\")\r\n"]
[3.569419, "o", "+        nocache_active = False\r\n+        if val is not None:\r\n"]
[3.569419, "o", "+            clean_val = str(val).strip().lower()\r\n"]
[3.56942, "o", "+            if clean_val in (\"1\", \"true\", \"yes\", \"on\"):\r\n"]
[3.569421, "o", "+                nocache_active = True\r\n"]
[3.569422, "o", "+            elif clean_val in (\"0\", \"false\", \"no\", \"off\"):\r\n"]
[3.569424, "o", "+                nocache_active = False\r\n"]
[3.569425, "o", "+\r\n"]
[3.569426, "o", "+        if not has_cb and not nocache_active:\r\n+            return None\r\n"]
[3.569428, "o", "+\r\n+        raw = cb.strip() if has_cb else _deployment_fallback_token()\r\n"]
[3.56943, "o", "+        token = _CACHE_BUST_TOKEN_RE.sub(\"\", str(raw))[:64]\r\n+        return token or \"bust\"\r\n"]
[3.569432, "o", "+\r\n+    def _append_asset_cache_bust(html: str, token: str) -> str:\r\n"]
[3.569433, "o", "+        def _repl(match: re.Match[str]) -> str:\r\n"]
[3.569434, "o", "+            url = match.group(2)\r\n"]
[3.569434, "o", "+            if re.search(r\"[?&]v=\", url):\r\n"]
[3.569435, "o", "+                return match.group(0)\r\n"]
[3.569435, "o", "+            sep = \"&\" if \"?\" in url else \"?\"\r\n"]
[3.569436, "o", "+            return f\"{match.group(1)}{url}{sep}v={token}{match.group(3)}\"\r\n"]
[3.569437, "o", "+\r\n+        return _FRONTEND_ASSET_ATTR_RE.sub(_repl, html)\r\n"]
[3.569438, "o", "+    # --- Frontend Serving ---\r\n"]
[3.569438, "o", "     @app.route(\"/\", defaults={\"path\": \"\"})\r\n"]
[3.56944, "o", "     @app.route(\"/<path:path>\")\r\n"]
[3.569441, "o", "     @limiter.exempt  # Exempt frontend routes from rate limiting\r\n"]
[3.569443, "o", "@@ -6348,6 +6407,19 @@ def create_app() -> Flask:\r\n"]
[3.569444, "o", "         # HTML must never be cached — cached HTML may reference old hashed\r\n"]
[3.569445, "o", "         # assets that no longer exist, causing 404s after deployments.\r\n"]
[3.569445, "o", "         # Content-hashed assets (JS/CSS) get long cache via /frontend_v1/ route.\r\n"]
[3.569446, "o", "+        bust_token = _html_cache_bust_token()\r\n"]
[3.569447, "o", "+        if bust_token:\r\n"]
[3.569448, "o", "+            html = _append_asset_cache_bust(response.get_data(as_text=True), bust_token)\r\n"]
[3.569449, "o", "+            busted = make_response(html)\r\n+            busted.headers[\"Content-Type\"] = response.headers.get(\r\n"]
[3.56945, "o", "+                \"Content-Type\", \"text/html; charset=utf-8\"\r\n"]
[3.569451, "o", "+            )\r\n"]
[3.569451, "o", "+            # Operator paste-in bust: do not reuse a cached HTML document\r\n"]
[3.569452, "o", "+            # that still points at yesterday's hashed CSS/JS.\r\n"]
[3.569453, "o", "+            busted.headers[\"Cache-Control\"] = \"no-store, must-revalidate\"\r\n"]
[3.569453, "o", "+            busted.headers[\"Pragma\"] = \"no-cache\"\r\n"]
[3.569454, "o", "+            return busted\r\n"]
[3.569455, "o", "+\r\n         response.headers[\"Cache-Control\"] = \"no-cache, must-revalidate\"\r\n"]
[3.569456, "o", "         return response\r\n"]
[3.569457, "o", " \r\n"]
